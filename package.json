{
  "name": "@kaynooo/changelogitea",
  "type": "module",
  "version": "1.1.5",
  "description": "Generate changelog for Gitea.",
  "author": "Kaynooo <contact@kaynooo.fr>",
  "license": "MIT",
  "homepage": "https://git.kaynooo.fr/kaynooo/changelogitea#readme",
  "repository": {
    "type": "git",
    "url": "git+https://git.kaynooo.fr/kaynooo/changelogitea.git"
  },
  "bugs": "https://git.kaynooo.fr/kaynooo/changelogitea/issues",
  "keywords": [
    "gitea",
    "release",
    "releases",
    "conventional",
    "changelog",
    "log"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "changelogitea": "./cli.mjs"
  },
  "files": [
    "*.mjs",
    "dist"
  ],
  "engines": {
    "node": ">=12.0.0"
  },
  "scripts": {
    "check": "tsgo --noEmit --strict",
    "build": "rm -rf ./dist && unbuild",
    "lint:fix": "bunx --bun eslint --fix",
    "lint": "bunx --bun eslint",
    "test": "vitest",
    "cli": "./cli.mjs"
  },
  "dependencies": {
    "@kaynooo/utils": "^1.8.1",
    "@typescript/native-preview": "^7.0.0-dev.20260225.1",
    "c12": "^3.3.3",
    "cac": "^6.7.14",
    "changelogen": "0.6.2",
    "convert-gitmoji": "^0.1.5",
    "execa": "^9.6.1",
    "semver": "^7.7.4"
  },
  "devDependencies": {
    "@kaynooo/eslint": "^1.5.7",
    "@types/bun": "^1.3.9",
    "@types/debug": "^4.1.12",
    "@types/semver": "^7.7.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "unbuild": "^3.6.1"
  }
}
