{
  "name": "changelogitea",
  "type": "module",
  "version": "1.0.1",
  "description": "Generate changelog for Gitea.",
  "author": "Kaynooo <contact@kaynooo.fr>",
  "license": "MIT",
  "homepage": "https://git.kaynooo.fr/kaynooo/changelogitea#readme",
  "repository": {
    "type": "git",
    "url": "git+https://git.kaynooo.fr/kaynooo/changelogitea.git"
  },
  "bugs": "https://git.kaynooo.fr/kaynooo/changelogitea/issues",
  "keywords": [
    "gitea",
    "release",
    "releases",
    "conventional",
    "changelog",
    "log"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": "./cli.mjs",
  "files": [
    "*.mjs",
    "dist"
  ],
  "engines": {
    "node": ">=12.0.0"
  },
  "scripts": {
    "check": "tsgo --noEmit --strict",
    "build": "rm -rf ./dist && unbuild",
    "lint:fix": "bunx --bun eslint --fix",
    "lint": "bunx --bun eslint",
    "test": "vitest",
    "cli": "./cli.mjs"
  },
  "dependencies": {
    "@typescript/native-preview": "^7.0.0-dev.20251015.1",
    "ansis": "^4.2.0",
    "c12": "^3.3.0",
    "cac": "^6.7.14",
    "changelogen": "0.6.2",
    "convert-gitmoji": "^0.1.5",
    "execa": "^9.6.0",
    "ofetch": "^1.4.1",
    "semver": "^7.7.3",
    "tinyglobby": "^0.2.15"
  },
  "devDependencies": {
    "@antfu/utils": "^9.3.0",
    "@kaynooo/eslint": "^1.3.13",
    "@types/debug": "^4.1.12",
    "@types/fs-extra": "^11.0.4",
    "@types/minimist": "^1.2.5",
    "@types/semver": "^7.7.1",
    "bumpp": "^10.3.1",
    "eslint": "^9.37.0",
    "fs-extra": "^11.3.2",
    "typescript": "^5.9.3",
    "unbuild": "^3.6.1",
    "vitest": "^3.2.4"
  }
}
