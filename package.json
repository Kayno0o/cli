{
  "name": "@kaynooo/changelogitea",
  "type": "module",
  "version": "1.6.0",
  "description": "Generate changelog for Gitea.",
  "author": "Kaynooo <contact@kaynooo.fr>",
  "license": "MIT",
  "homepage": "https://git.kaynooo.fr/kaynooo/changelogitea#readme",
  "repository": {
    "type": "git",
    "url": "git+https://git.kaynooo.fr/kaynooo/changelogitea.git"
  },
  "bugs": "https://git.kaynooo.fr/kaynooo/changelogitea/issues",
  "keywords": [
    "gitea",
    "release",
    "releases",
    "conventional",
    "changelog",
    "log"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "changelogitea": "./cli.mjs"
  },
  "files": [
    "*.mjs",
    "dist"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "check": "tsgo --noEmit --strict",
    "build": "rm -rf ./dist && unbuild",
    "lint:fix": "bunx --bun eslint --fix",
    "lint": "bunx --bun eslint",
    "test": "bun test",
    "cli": "./cli.mjs"
  },
  "dependencies": {
    "@kaynooo/utils": "^2.0.1",
    "c12": "^3.3.4",
    "cac": "^6.7.14",
    "convert-gitmoji": "^0.1.5"
  },
  "devDependencies": {
    "@kaynooo/eslint": "^3.0.1",
    "@types/bun": "^1.3.14",
    "@types/debug": "^4.1.13",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "eslint": "^10.6.0",
    "typescript": "6",
    "unbuild": "^3.6.1"
  }
}
