{
  "name": "cli",
  "type": "module",
  "private": true,
  "description": "CLIs built for Claude Code agents: Forgejo and GitLab CI, .env files without secrets, repo checks, guards and more.",
  "author": "Kaynooo <contact@kaynooo.fr>",
  "license": "MIT",
  "workspaces": ["packages/*"],
  "scripts": {
    "check": "$npm_execpath check",
    "lint": "keslint --cache",
    "lint:fix": "keslint --fix --cache",
    "test": "$npm_execpath test --parallel",
    "ft": "$npm_execpath packages/ft/src/cli.ts"
  },
  "devDependencies": {
    "@kaynooo/eslint": "^7.1.4",
    "@types/bun": "^1.4.3"
  },
  "overrides": {
    "katex": "^0.18.2",
    "minimatch": "^11.0.3",
    "tinypool": "^2.2.0"
  }
}
