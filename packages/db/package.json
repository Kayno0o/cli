{
  "name": "@kaynooo/cli-db",
  "type": "module",
  "version": "0.13.7",
  "description": "db: run read-only SQL against Postgres, MySQL and MariaDB from the terminal without ever showing the connection credentials.",
  "author": "Kaynooo <contact@kaynooo.fr>",
  "license": "MIT",
  "homepage": "https://github.com/Kayno0o/cli/tree/main/packages/db#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kayno0o/cli.git",
    "directory": "packages/db"
  },
  "bugs": "https://github.com/Kayno0o/cli/issues",
  "keywords": [
    "postgres",
    "mysql",
    "mariadb",
    "sql",
    "read-only",
    "cli",
    "bun"
  ],
  "exports": {
    "./guard": "./src/clients.ts"
  },
  "bin": {
    "db": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src/clients.ts",
    "src/guard-test.ts",
    "src/guard.ts",
    "src/sql-tokens.ts"
  ],
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "build": "$npm_execpath ../../scripts/build.ts src/cli.ts",
    "db": "$npm_execpath src/cli.ts"
  },
  "dependencies": {
    "@kaynooo/cli-kit": "workspace:*"
  }
}
