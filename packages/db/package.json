{
  "name": "@kaynooo/cli-db",
  "type": "module",
  "version": "0.8.1",
  "description": "db: run read-only SQL against Postgres, MySQL and MariaDB from the terminal without ever showing the connection credentials.",
  "author": "Kaynooo <contact@kaynooo.fr>",
  "license": "MIT",
  "homepage": "https://git.kaynooo.fr/kaynooo/cli/src/branch/main/packages/db#readme",
  "repository": {
    "type": "git",
    "url": "git+https://git.kaynooo.fr/kaynooo/cli.git",
    "directory": "packages/db"
  },
  "bugs": "https://git.kaynooo.fr/kaynooo/cli/issues",
  "keywords": ["postgres", "mysql", "mariadb", "sql", "read-only", "cli", "bun"],
  "bin": {
    "db": "./dist/cli.js"
  },
  "files": ["dist"],
  "engines": {
    "bun": ">=1.4.3"
  },
  "publishConfig": {
    "registry": "https://git.kaynooo.fr/api/packages/kaynooo/npm/"
  },
  "scripts": {
    "build": "$npm_execpath build src/cli.ts --target bun --outdir dist",
    "db": "$npm_execpath src/cli.ts"
  },
  "devDependencies": {
    "@kaynooo/cli-kit": "workspace:*"
  }
}
