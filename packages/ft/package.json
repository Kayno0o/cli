{
  "name": "@kaynooo/cli-forgejo",
  "type": "module",
  "version": "0.30.8",
  "description": "ft: Forgejo CI runs, logs, releases and issue checklists from the terminal, through tea.",
  "author": "Kaynooo <contact@kaynooo.fr>",
  "license": "MIT",
  "homepage": "https://github.com/Kayno0o/cli/tree/main/packages/ft#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kayno0o/cli.git",
    "directory": "packages/ft"
  },
  "bugs": "https://github.com/Kayno0o/cli/issues",
  "keywords": ["forgejo", "gitea", "tea", "ci", "actions", "release"],
  "bin": {
    "ft": "./dist/cli.js"
  },
  "files": ["dist"],
  "engines": {
    "bun": ">=1.4.3"
  },
  "publishConfig": {
    "registry": "https://git.kaynooo.fr/api/packages/kaynooo/npm/"
  },
  "scripts": {
    "build": "$npm_execpath build src/cli.ts --target bun --outdir dist",
    "ft": "$npm_execpath src/cli.ts"
  },
  "dependencies": {
    "@kaynooo/utils": "3.1.0"
  },
  "devDependencies": {
    "@kaynooo/cli-kit": "workspace:*"
  }
}
