{
  "name": "@kaynooo/cli-forge",
  "type": "module",
  "version": "0.31.0",
  "description": "fg (ft): unified Forgejo, GitHub and GitLab CLI over direct HTTP — CI runs, logs, PRs/MRs, issues, milestones and releases.",
  "author": "Kaynooo <contact@kaynooo.fr>",
  "license": "MIT",
  "homepage": "https://github.com/Kayno0o/cli/tree/main/packages/ft#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kayno0o/cli.git",
    "directory": "packages/ft"
  },
  "bugs": "https://github.com/Kayno0o/cli/issues",
  "keywords": [
    "forgejo",
    "github",
    "gitlab",
    "forge",
    "ci",
    "pr",
    "release"
  ],
  "bin": {
    "fg": "./dist/fg.js",
    "ft": "./dist/ft.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "build": "$npm_execpath ../../scripts/build.ts src/fg.ts src/ft.ts --splitting",
    "fg": "$npm_execpath src/fg.ts",
    "ft": "$npm_execpath src/ft.ts"
  },
  "devDependencies": {
    "@kaynooo/cli-changelog": "workspace:*",
    "@kaynooo/cli-kit": "workspace:*",
    "@kaynooo/utils": "3.1.0"
  }
}
