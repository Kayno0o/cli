{
  "name": "@kaynooo/check-tools",
  "type": "module",
  "version": "0.3.0",
  "description": "check and fix: run a repo's check, typecheck, lint and test steps or its fixers, showing only what failed, with each full output saved to a file.",
  "author": "Kaynooo <contact@kaynooo.fr>",
  "license": "MIT",
  "homepage": "https://git.kaynooo.fr/kaynooo/agent-tools/src/branch/main/packages/check#readme",
  "repository": {
    "type": "git",
    "url": "git+https://git.kaynooo.fr/kaynooo/agent-tools.git",
    "directory": "packages/check"
  },
  "bugs": "https://git.kaynooo.fr/kaynooo/agent-tools/issues",
  "keywords": ["check", "fix", "lint", "format", "typecheck", "test", "claude-code"],
  "bin": {
    "check": "./dist/cli.js",
    "fix": "./dist/fix-cli.js"
  },
  "files": ["dist"],
  "engines": {
    "bun": ">=1.4.3"
  },
  "publishConfig": {
    "registry": "https://git.kaynooo.fr/api/packages/kaynooo/npm/"
  },
  "scripts": {
    "build": "$npm_execpath build src/cli.ts src/fix-cli.ts --target bun --outdir dist"
  },
  "devDependencies": {
    "@kaynooo/cli-kit": "workspace:*"
  }
}
