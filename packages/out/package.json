{
  "name": "@kaynooo/cli-out",
  "type": "module",
  "version": "0.15.0",
  "description": "out: shortens noisy command output for Claude Code, folding long logs and keeping errors, with the full log saved to a file.",
  "author": "Kaynooo <contact@kaynooo.fr>",
  "license": "MIT",
  "homepage": "https://github.com/Kayno0o/cli/tree/main/packages/out#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kayno0o/cli.git",
    "directory": "packages/out"
  },
  "bugs": "https://github.com/Kayno0o/cli/issues",
  "keywords": [
    "claude-code",
    "cli",
    "output",
    "logs",
    "tokens"
  ],
  "exports": {
    "./wrap": "./src/wrap.ts"
  },
  "bin": {
    "out": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src/stages.ts",
    "src/wrap.ts"
  ],
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "build": "$npm_execpath ../../scripts/build.ts src/cli.ts",
    "out": "$npm_execpath src/cli.ts"
  },
  "dependencies": {
    "@kaynooo/cli-kit": "workspace:*",
    "@kaynooo/utils": "3.1.0"
  }
}
