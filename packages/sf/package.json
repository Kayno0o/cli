  "description": "sf: picks and runs Symfony console commands in a compose PHP service or local php.",
  "author": "Kaynooo <contact@kaynooo.fr>",
  "license": "MIT",
  "homepage": "https://github.com/Kayno0o/cli/tree/main/packages/sf#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kayno0o/cli.git",
    "directory": "packages/sf"
  },
  "bugs": "https://github.com/Kayno0o/cli/issues",
  "keywords": [
    "symfony",
    "php",
    "console",
    "cli",
    "bun"
  ],
  "bin": {
    "sf": "./dist/sf-cli.js"
  },
