{
  "name": "@kaynooo/cli-probe",
  "type": "module",
  "version": "0.4.4",
  "description": "probe: a site's HTTP version, redirect chain, timings, addresses, TLS certificate and notable headers in one call, with warnings.",
  "author": "Kaynooo <contact@kaynooo.fr>",
  "license": "MIT",
  "homepage": "https://github.com/Kayno0o/cli/tree/main/packages/probe#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kayno0o/cli.git",
    "directory": "packages/probe"
  },
  "bugs": "https://github.com/Kayno0o/cli/issues",
  "keywords": [
    "cli",
    "http",
    "tls",
    "curl"
  ],
  "bin": {
    "probe": "./dist/probe.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "bun": ">=1.4.3"
  },
  "publishConfig": {
    "registry": "https://git.kaynooo.fr/api/packages/kaynooo/npm/"
  },
  "scripts": {
    "build": "$npm_execpath build src/probe.ts --target bun --outdir dist",
    "probe": "$npm_execpath src/probe.ts"
  },
  "devDependencies": {
    "@kaynooo/cli-kit": "workspace:*"
  }
}
