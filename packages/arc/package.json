{
  "name": "@kaynooo/cli-arc",
  "type": "module",
  "version": "0.7.0",
  "description": "arc: browses an archive without extracting it, packs a folder into a verified .tar.zst before deleting it, unpacks one without overwriting anything and checks it, and extracts any other archive.",
  "author": "Kaynooo <contact@kaynooo.fr>",
  "license": "MIT",
  "homepage": "https://github.com/Kayno0o/cli/tree/main/packages/arc#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kayno0o/cli.git",
    "directory": "packages/arc"
  },
  "bugs": "https://github.com/Kayno0o/cli/issues",
  "keywords": [
    "cli",
    "archive",
    "tar",
    "zstd",
    "backup"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "arc": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "build": "$npm_execpath ../../scripts/build.ts src/cli.ts --splitting",
    "arc": "$npm_execpath src/cli.ts"
  },
  "dependencies": {
    "@kaynooo/cli-kit": "workspace:*"
  }
}
