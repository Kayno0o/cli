{
  "name": "@kaynooo/cli-git",
  "type": "module",
  "version": "0.15.0",
  "description": "gst, gc, gb and gp: a repository's state in one call, a commit of exactly the paths given, its message checked before anything is staged, a branch picked, and the branches of nested repositories pushed.",
  "author": "Kaynooo <contact@kaynooo.fr>",
  "license": "MIT",
  "homepage": "https://git.kaynooo.fr/kaynooo/cli/src/branch/main/packages/git#readme",
  "repository": {
    "type": "git",
    "url": "git+https://git.kaynooo.fr/kaynooo/cli.git",
    "directory": "packages/git"
  },
  "bugs": "https://git.kaynooo.fr/kaynooo/cli/issues",
  "keywords": [
    "claude-code",
    "cli",
    "git",
    "status",
    "commit"
  ],
  "exports": {
    "./message": "./src/message.ts"
  },
  "bin": {
    "gst": "./dist/gst.js",
    "gc": "./dist/gc.js",
    "gb": "./dist/gb.js",
    "gp": "./dist/gp.js"
  },
  "files": [
    "dist",
    "src/message.ts"
  ],
  "engines": {
    "bun": ">=1.4.3"
  },
  "publishConfig": {
    "registry": "https://git.kaynooo.fr/api/packages/kaynooo/npm/"
  },
  "scripts": {
    "build": "$npm_execpath build src/gst.ts src/gc.ts src/gb.ts src/gp.ts --target bun --outdir dist",
    "gst": "$npm_execpath src/gst.ts",
    "gc": "$npm_execpath src/gc.ts",
    "gb": "$npm_execpath src/gb.ts",
    "gp": "$npm_execpath src/gp.ts"
  },
  "devDependencies": {
    "@kaynooo/cli-kit": "workspace:*"
  }
}
