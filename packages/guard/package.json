{
  "name": "@kaynooo/cli-guard",
  "type": "module",
  "version": "0.14.3",
  "description": "guard: the safety rules a Claude Code Bash call is held to (git, remote machines, SQL writes, env files, package managers, commit messages), each refusal naming the route.",
  "author": "Kaynooo <contact@kaynooo.fr>",
  "license": "MIT",
  "homepage": "https://github.com/Kayno0o/cli/tree/main/packages/guard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kayno0o/cli.git",
    "directory": "packages/guard"
  },
  "bugs": "https://github.com/Kayno0o/cli/issues",
  "keywords": [
    "claude-code",
    "cli",
    "guard",
    "hooks",
    "safety"
  ],
  "bin": {
    "guard": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "bun": ">=1.4.3"
  },
  "publishConfig": {
    "registry": "https://git.kaynooo.fr/api/packages/kaynooo/npm/"
  },
  "scripts": {
    "build": "$npm_execpath build src/cli.ts --target bun --outdir dist",
    "guard": "$npm_execpath src/cli.ts"
  },
  "devDependencies": {
    "@kaynooo/cli-db": "workspace:*",
    "@kaynooo/cli-edit": "workspace:*",
    "@kaynooo/cli-env": "workspace:*",
    "@kaynooo/cli-git": "workspace:*",
    "@kaynooo/cli-kit": "workspace:*",
    "@kaynooo/cli-out": "workspace:*",
    "@kaynooo/cli-pkg": "workspace:*"
  }
}
