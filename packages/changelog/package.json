{
  "name": "@kaynooo/cli-changelog",
  "type": "module",
  "version": "2.3.6",
  "description": "Generates a release's changelog from its conventional commits and publishes it as a Forgejo release.",
  "author": "Kaynooo <contact@kaynooo.fr>",
  "license": "MIT",
  "homepage": "https://github.com/Kayno0o/cli/tree/main/packages/changelog#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kayno0o/cli.git",
    "directory": "packages/changelog"
  },
  "bugs": "https://github.com/Kayno0o/cli/issues",
  "keywords": ["forgejo", "gitea", "release", "changelog", "conventional-commits"],
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "changelog": "./dist/cli.js"
  },
  "files": ["dist", "src"],
  "engines": {
    "bun": ">=1.4.3"
  },
  "publishConfig": {
    "registry": "https://git.kaynooo.fr/api/packages/kaynooo/npm/"
  },
  "scripts": {
    "build": "$npm_execpath build src/cli.ts --target bun --outdir dist",
    "changelog": "$npm_execpath src/cli.ts"
  },
  "dependencies": {
    "@kaynooo/cli-kit": "workspace:*",
    "@kaynooo/utils": "3.0.0"
  }
}
