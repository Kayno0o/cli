{
  "name": "@kaynooo/cli-wait",
  "type": "module",
  "version": "0.6.1",
  "description": "waitfor and slot: waits for a log line, a listening port or a URL answering, and queues heavy commands behind machine-wide slots and named locks, for Claude Code, instead of sleep and polling loops.",
  "author": "Kaynooo <contact@kaynooo.fr>",
  "license": "MIT",
  "homepage": "https://git.kaynooo.fr/kaynooo/cli/src/branch/main/packages/wait#readme",
  "repository": {
    "type": "git",
    "url": "git+https://git.kaynooo.fr/kaynooo/cli.git",
    "directory": "packages/wait"
  },
  "bugs": "https://git.kaynooo.fr/kaynooo/cli/issues",
  "keywords": [
    "claude-code",
    "cli",
    "wait",
    "log",
    "port"
  ],
  "bin": {
    "waitfor": "./dist/cli.js",
    "slot": "./dist/slot-cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "bun": ">=1.4.3"
  },
  "publishConfig": {
    "registry": "https://git.kaynooo.fr/api/packages/kaynooo/npm/"
  },
  "scripts": {
    "build": "$npm_execpath build src/cli.ts src/slot-cli.ts --target bun --outdir dist",
    "slot": "$npm_execpath src/slot-cli.ts",
    "waitfor": "$npm_execpath src/cli.ts"
  },
  "devDependencies": {
    "@kaynooo/cli-kit": "workspace:*"
  }
}
