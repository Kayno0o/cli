{
  "name": "@kaynooo/cli-env",
  "type": "module",
  "version": "0.15.1",
  "description": "ev lists and edits .env files with secrets masked, and ev redact masks secrets in any piped output.",
  "author": "Kaynooo <contact@kaynooo.fr>",
  "license": "MIT",
  "homepage": "https://github.com/Kayno0o/cli/tree/main/packages/env#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kayno0o/cli.git",
    "directory": "packages/env"
  },
  "bugs": "https://github.com/Kayno0o/cli/issues",
  "keywords": ["env", "dotenv", "secrets", "redact", "mask"],
  "exports": {
    "./dotenv": "./src/dotenv.ts",
    "./files": "./src/files.ts",
    "./guard": "./src/guard.ts",
    "./mask": "./src/mask.ts",
    "./redactor": "./src/redactor.ts"
  },
  "bin": {
    "ev": "./dist/ev.js"
  },
  "files": ["dist", "src"],
  "engines": {
    "bun": ">=1.4.3"
  },
  "publishConfig": {
    "registry": "https://git.kaynooo.fr/api/packages/kaynooo/npm/"
  },
  "scripts": {
    "build": "$npm_execpath build src/ev.ts --target bun --outdir dist",
    "ev": "$npm_execpath src/ev.ts"
  },
  "dependencies": {
    "@kaynooo/cli-kit": "workspace:*"
  }
}
