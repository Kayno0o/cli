{
  "name": "@kaynooo/env-tools",
  "type": "module",
  "version": "0.0.0",
  "description": "ev lists and edits .env files with secrets masked, redact masks secrets in any piped output.",
  "author": "Kaynooo <contact@kaynooo.fr>",
  "license": "MIT",
  "homepage": "https://git.kaynooo.fr/kaynooo/agent-tools/src/branch/main/packages/env#readme",
  "repository": {
    "type": "git",
    "url": "git+https://git.kaynooo.fr/kaynooo/agent-tools.git",
    "directory": "packages/env"
  },
  "bugs": "https://git.kaynooo.fr/kaynooo/agent-tools/issues",
  "keywords": ["env", "dotenv", "secrets", "redact", "mask"],
  "bin": {
    "ev": "./src/ev.ts",
    "redact": "./src/redact.ts"
  },
  "files": ["src"],
  "engines": {
    "bun": ">=1.4.3"
  },
  "publishConfig": {
    "registry": "https://git.kaynooo.fr/api/packages/kaynooo/npm/"
  },
  "scripts": {
    "ev": "$npm_execpath src/ev.ts",
    "redact": "$npm_execpath src/redact.ts"
  },
  "dependencies": {
    "@kaynooo/cli-kit": "workspace:^"
  }
}
