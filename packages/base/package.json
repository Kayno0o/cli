{
  "name": "@kaynooo/cli-base",
  "type": "module",
  "version": "0.6.0",
  "description": "base: a command run at HEAD or another ref in a temporary worktree, the working tree left untouched.",
  "author": "Kaynooo <contact@kaynooo.fr>",
  "license": "MIT",
  "homepage": "https://git.kaynooo.fr/kaynooo/cli/src/branch/main/packages/base#readme",
  "repository": {
    "type": "git",
    "url": "git+https://git.kaynooo.fr/kaynooo/cli.git",
    "directory": "packages/base"
  },
  "bugs": "https://git.kaynooo.fr/kaynooo/cli/issues",
  "keywords": [
    "claude-code",
    "cli",
    "git",
    "worktree",
    "stash"
  ],
  "bin": {
    "base": "./dist/cli.js",
    "proof": "./dist/proof-cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "bun": ">=1.4.3"
  },
  "publishConfig": {
    "registry": "https://git.kaynooo.fr/api/packages/kaynooo/npm/"
  },
  "scripts": {
    "build": "$npm_execpath build src/cli.ts src/proof-cli.ts --target bun --outdir dist",
    "base": "$npm_execpath src/cli.ts",
    "proof": "$npm_execpath src/proof-cli.ts"
  },
  "devDependencies": {
    "@kaynooo/cli-kit": "workspace:*"
  }
}
