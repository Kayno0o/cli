{
  "name": "@kaynooo/cli-gloss",
  "type": "module",
  "version": "0.0.5",
  "description": "gloss: explains a shell command line, each word matched to what its man page says.",
  "author": "Kaynooo <contact@kaynooo.fr>",
  "license": "MIT",
  "homepage": "https://github.com/Kayno0o/cli/tree/main/packages/gloss#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kayno0o/cli.git",
    "directory": "packages/gloss"
  },
  "bugs": "https://github.com/Kayno0o/cli/issues",
  "keywords": [
    "cli",
    "explainshell",
    "man",
    "shell"
  ],
  "bin": {
    "gloss": "./dist/gloss.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "bun": ">=1.4.3"
  },
  "publishConfig": {
    "registry": "https://git.kaynooo.fr/api/packages/kaynooo/npm/"
  },
  "scripts": {
    "build": "$npm_execpath build src/gloss.ts --target bun --outdir dist",
    "gloss": "$npm_execpath src/gloss.ts"
  },
  "devDependencies": {
    "@kaynooo/cli-kit": "workspace:*"
  }
}
