{
  "name": "@kaynooo/cli-gitlab",
  "type": "module",
  "version": "0.11.3",
  "description": "gl: GitLab pipelines waited on and their failed jobs' traces read from the terminal, through glab.",
  "author": "Kaynooo <contact@kaynooo.fr>",
  "license": "MIT",
  "homepage": "https://github.com/Kayno0o/cli/tree/main/packages/gitlab#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kayno0o/cli.git",
    "directory": "packages/gitlab"
  },
  "bugs": "https://github.com/Kayno0o/cli/issues",
  "keywords": [
    "gitlab",
    "glab",
    "ci",
    "pipelines",
    "claude-code"
  ],
  "bin": {
    "gl": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "bun": ">=1.4.3"
  },
  "publishConfig": {
    "registry": "https://git.kaynooo.fr/api/packages/kaynooo/npm/"
  },
  "scripts": {
    "build": "$npm_execpath build src/cli.ts --target bun --outdir dist",
    "gl": "$npm_execpath src/cli.ts"
  },
  "devDependencies": {
    "@kaynooo/cli-kit": "workspace:*"
  }
}
