{
  "name": "@kaynooo/cli-wt",
  "type": "module",
  "version": "0.1.11",
  "description": "wt: git worktrees of a compose project, each with its own stack, data and <task>.<host> subdomains beside main.",
  "author": "Kaynooo <contact@kaynooo.fr>",
  "license": "MIT",
  "homepage": "https://github.com/Kayno0o/cli/tree/main/packages/wt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kayno0o/cli.git",
    "directory": "packages/wt"
  },
  "bugs": "https://github.com/Kayno0o/cli/issues",
  "keywords": [
    "git",
    "worktree",
    "docker",
    "compose",
    "devproxy",
    "cli",
    "bun"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "wt": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "build": "$npm_execpath ../../scripts/build.ts src/cli.ts --splitting",
    "wt": "$npm_execpath src/cli.ts"
  },
  "dependencies": {
    "@kaynooo/cli-env": "workspace:*",
    "@kaynooo/cli-kit": "workspace:*",
    "@kaynooo/devproxy": "0.2.1",
    "@kaynooo/utils": "3.1.0"
  }
}
