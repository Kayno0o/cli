{
  "name": "@kaynooo/cli-audit",
  "type": "module",
  "version": "0.0.0",
  "description": "audit: the known vulnerabilities of every Bun repository of a workspace in one table, each with its severity, whether it reaches production, whether the repository asks for the package itself, and the version that fixes it.",
  "author": "Kaynooo <contact@kaynooo.fr>",
  "license": "MIT",
  "homepage": "https://git.kaynooo.fr/kaynooo/cli/src/branch/main/packages/audit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://git.kaynooo.fr/kaynooo/cli.git",
    "directory": "packages/audit"
  },
  "bugs": "https://git.kaynooo.fr/kaynooo/cli/issues",
  "keywords": ["cli", "audit", "security", "vulnerabilities", "bun"],
  "bin": {
    "audit": "./dist/audit.js"
  },
  "files": ["dist"],
  "engines": {
    "bun": ">=1.4.3"
  },
  "publishConfig": {
    "registry": "https://git.kaynooo.fr/api/packages/kaynooo/npm/"
  },
  "scripts": {
    "build": "$npm_execpath build src/audit.ts --target bun --outdir dist",
    "audit": "$npm_execpath src/audit.ts"
  },
  "devDependencies": {
    "@kaynooo/cli-kit": "workspace:*"
  }
}
