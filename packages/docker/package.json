{
  "name": "@kaynooo/cli-docker",
  "type": "module",
  "version": "0.0.0",
  "description": "dc and dx: docker compose on the stack found here, including one only its containers tell of, and a compose service's shell, logs, restart, stop or rebuild.",
  "author": "Kaynooo <contact@kaynooo.fr>",
  "license": "MIT",
  "homepage": "https://git.kaynooo.fr/kaynooo/cli/src/branch/main/packages/docker#readme",
  "repository": {
    "type": "git",
    "url": "git+https://git.kaynooo.fr/kaynooo/cli.git",
    "directory": "packages/docker"
  },
  "bugs": "https://git.kaynooo.fr/kaynooo/cli/issues",
  "keywords": ["docker", "compose", "cli", "bun"],
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "dc": "./dist/dc-cli.js",
    "dx": "./dist/dx-cli.js"
  },
  "files": ["dist", "src"],
  "engines": {
    "bun": ">=1.4.3"
  },
  "publishConfig": {
    "registry": "https://git.kaynooo.fr/api/packages/kaynooo/npm/"
  },
  "scripts": {
    "build": "$npm_execpath build src/dc-cli.ts src/dx-cli.ts --target bun --outdir dist",
    "dc": "$npm_execpath src/dc-cli.ts",
    "dx": "$npm_execpath src/dx-cli.ts"
  },
  "devDependencies": {
    "@kaynooo/cli-kit": "workspace:*"
  }
}
