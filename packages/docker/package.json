{
  "name": "@kaynooo/cli-docker",
  "type": "module",
  "version": "0.11.0",
  "description": "dc: unified Docker Compose CLI — service picker/listing, health & error summary, redacted logs, shell/exec, deterministic ports, and compose passthrough.",
  "author": "Kaynooo <contact@kaynooo.fr>",
  "license": "MIT",
  "homepage": "https://github.com/Kayno0o/cli/tree/main/packages/docker#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kayno0o/cli.git",
    "directory": "packages/docker"
  },
  "bugs": "https://github.com/Kayno0o/cli/issues",
  "keywords": [
    "docker",
    "compose",
    "cli",
    "bun"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "dc": "./dist/dc-cli.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "build": "$npm_execpath ../../scripts/build.ts src/dc-cli.ts",
    "dc": "$npm_execpath src/dc-cli.ts"
  },
  "dependencies": {
    "@kaynooo/cli-env": "workspace:*",
    "@kaynooo/cli-kit": "workspace:*",
    "@kaynooo/utils": "3.1.0"
  }
}
