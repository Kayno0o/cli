{
  "name": "@kaynooo/cli-pkg",
  "type": "module",
  "version": "0.18.1",
  "description": "pkg: check an npm package before it is added, for a guessed name, a version under two weeks old and install scripts.",
  "author": "Kaynooo <contact@kaynooo.fr>",
  "license": "MIT",
  "homepage": "https://github.com/Kayno0o/cli/tree/main/packages/pkg#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kayno0o/cli.git",
    "directory": "packages/pkg"
  },
  "bugs": "https://github.com/Kayno0o/cli/issues",
  "keywords": [
    "npm",
    "package",
    "typosquat",
    "supply-chain",
    "dependencies"
  ],
  "bin": {
    "pkg": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "build": "$npm_execpath ../../scripts/build.ts src/cli.ts --splitting",
    "pkg": "$npm_execpath src/cli.ts",
    "popular": "$npm_execpath scripts/popular.ts",
    "record": "$npm_execpath scripts/record.ts"
  },
  "devDependencies": {
    "@kaynooo/cli-kit": "workspace:*",
    "@kaynooo/utils": "3.1.0"
  }
}
