{
  "name": "@kaynooo/cli-pkg",
  "type": "module",
  "version": "0.15.0",
  "description": "pkg: check an npm package before it is added, for a guessed name, a version under two weeks old and install scripts.",
  "author": "Kaynooo <contact@kaynooo.fr>",
  "license": "MIT",
  "homepage": "https://git.kaynooo.fr/kaynooo/cli/src/branch/main/packages/pkg#readme",
  "repository": {
    "type": "git",
    "url": "git+https://git.kaynooo.fr/kaynooo/cli.git",
    "directory": "packages/pkg"
  },
  "bugs": "https://git.kaynooo.fr/kaynooo/cli/issues",
  "keywords": ["npm", "package", "typosquat", "supply-chain", "dependencies"],
  "bin": {
    "pkg": "./dist/cli.js"
  },
  "files": ["dist"],
  "engines": {
    "bun": ">=1.4.3"
  },
  "publishConfig": {
    "registry": "https://git.kaynooo.fr/api/packages/kaynooo/npm/"
  },
  "scripts": {
    "build": "$npm_execpath build src/cli.ts --target bun --outdir dist",
    "pkg": "$npm_execpath src/cli.ts",
    "popular": "$npm_execpath scripts/popular.ts",
    "record": "$npm_execpath scripts/record.ts"
  },
  "dependencies": {
    "@kaynooo/utils": "3.0.0"
  },
  "devDependencies": {
    "@kaynooo/cli-kit": "workspace:*"
  }
}
