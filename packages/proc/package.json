{
  "name": "@kaynooo/cli-proc",
  "type": "module",
  "version": "0.8.1",
  "description": "proc: one process inspected, who listens on a port, and leftover or heavy dev processes cleaned, read straight from /proc (Linux).",
  "author": "Kaynooo <contact@kaynooo.fr>",
  "license": "MIT",
  "homepage": "https://github.com/Kayno0o/cli/tree/main/packages/proc#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kayno0o/cli.git",
    "directory": "packages/proc"
  },
  "bugs": "https://github.com/Kayno0o/cli/issues",
  "keywords": ["process", "port", "proc", "kill", "cli", "bun"],
  "os": ["linux"],
  "bin": {
    "proc": "./dist/proc-cli.js"
  },
  "files": ["dist", "src"],
  "engines": {
    "bun": ">=1.4.3"
  },
  "publishConfig": {
    "registry": "https://git.kaynooo.fr/api/packages/kaynooo/npm/"
  },
  "scripts": {
    "build": "$npm_execpath build src/proc-cli.ts --target bun --outdir dist",
    "proc": "$npm_execpath src/proc-cli.ts"
  },
  "devDependencies": {
    "@kaynooo/cli-kit": "workspace:*"
  }
}
