{
  "name": "@kaynooo/cli-code",
  "type": "module",
  "version": "0.6.1",
  "description": "peek, todo-scan and hotspots: source read by spans, symbols and outlines in one call, the TODO and issue-reference comments of a repository with stale ones flagged, and the files ranked by complexity times git churn.",
  "author": "Kaynooo <contact@kaynooo.fr>",
  "license": "MIT",
  "homepage": "https://git.kaynooo.fr/kaynooo/cli/src/branch/main/packages/code#readme",
  "repository": {
    "type": "git",
    "url": "git+https://git.kaynooo.fr/kaynooo/cli.git",
    "directory": "packages/code"
  },
  "bugs": "https://git.kaynooo.fr/kaynooo/cli/issues",
  "keywords": [
    "claude-code",
    "cli",
    "code",
    "todo",
    "outline",
    "hotspots"
  ],
  "bin": {
    "peek": "./dist/peek.js",
    "todo-scan": "./dist/todo-scan.js",
    "hotspots": "./dist/hotspots.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "bun": ">=1.4.3"
  },
  "publishConfig": {
    "registry": "https://git.kaynooo.fr/api/packages/kaynooo/npm/"
  },
  "scripts": {
    "build": "$npm_execpath build src/peek.ts src/todo-scan.ts src/hotspots.ts --target bun --outdir dist",
    "peek": "$npm_execpath src/peek.ts",
    "todo-scan": "$npm_execpath src/todo-scan.ts",
    "hotspots": "$npm_execpath src/hotspots.ts"
  },
  "devDependencies": {
    "@kaynooo/cli-kit": "workspace:*"
  }
}
