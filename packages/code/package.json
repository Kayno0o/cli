{
  "name": "@kaynooo/code-tools",
  "type": "module",
  "version": "0.1.1",
  "description": "peek and todo-scan: source read by spans, symbols and outlines in one call, and the TODO and issue-reference comments of a repository, stale ones flagged.",
  "author": "Kaynooo <contact@kaynooo.fr>",
  "license": "MIT",
  "homepage": "https://git.kaynooo.fr/kaynooo/agent-tools/src/branch/main/packages/code#readme",
  "repository": {
    "type": "git",
    "url": "git+https://git.kaynooo.fr/kaynooo/agent-tools.git",
    "directory": "packages/code"
  },
  "bugs": "https://git.kaynooo.fr/kaynooo/agent-tools/issues",
  "keywords": [
    "claude-code",
    "cli",
    "code",
    "todo",
    "outline"
  ],
  "bin": {
    "peek": "./dist/peek.js",
    "todo-scan": "./dist/todo-scan.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "bun": ">=1.4.3"
  },
  "publishConfig": {
    "registry": "https://git.kaynooo.fr/api/packages/kaynooo/npm/"
  },
  "scripts": {
    "build": "$npm_execpath build src/peek.ts src/todo-scan.ts --target bun --outdir dist",
    "peek": "$npm_execpath src/peek.ts",
    "todo-scan": "$npm_execpath src/todo-scan.ts"
  },
  "devDependencies": {
    "@kaynooo/cli-kit": "workspace:*"
  }
}
