{
  "name": "@kaynooo/cli-page",
  "type": "module",
  "version": "0.6.0",
  "description": "page: shoots HTML files or URLs at several widths in a local Chromium and reports their layout defects one line each, or diffs a built page against its mockup.",
  "author": "Kaynooo <contact@kaynooo.fr>",
  "license": "MIT",
  "homepage": "https://github.com/Kayno0o/cli/tree/main/packages/page#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kayno0o/cli.git",
    "directory": "packages/page"
  },
  "bugs": "https://github.com/Kayno0o/cli/issues",
  "keywords": [
    "cli",
    "screenshot",
    "layout",
    "chromium",
    "playwright",
    "mockup"
  ],
  "bin": {
    "page": "./dist/cli.js"
  },
  "files": [
    "dist",
    "inpage/*.ts"
  ],
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "build": "$npm_execpath ../../scripts/build.ts src/cli.ts --external playwright-core --splitting",
    "page": "$npm_execpath src/cli.ts"
  },
  "dependencies": {
    "playwright-core": "1.64.1"
  },
  "devDependencies": {
    "@kaynooo/audit-engine": "0.1.1",
    "@kaynooo/cli-kit": "workspace:*"
  }
}
