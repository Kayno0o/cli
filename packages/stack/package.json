{
  "name": "@kaynooo/stack-tools",
  "type": "module",
  "version": "0.1.0",
  "description": "stack: a stable port per service name, and an audit of a compose release setup against its release.config.ts.",
  "author": "Kaynooo <contact@kaynooo.fr>",
  "license": "MIT",
  "homepage": "https://git.kaynooo.fr/kaynooo/agent-tools/src/branch/main/packages/stack#readme",
  "repository": {
    "type": "git",
    "url": "git+https://git.kaynooo.fr/kaynooo/agent-tools.git",
    "directory": "packages/stack"
  },
  "bugs": "https://git.kaynooo.fr/kaynooo/agent-tools/issues",
  "keywords": ["docker", "compose", "port", "release", "cli", "bun"],
  "bin": {
    "stack": "./dist/cli.js"
  },
  "files": ["dist"],
  "engines": {
    "bun": ">=1.4.3"
  },
  "publishConfig": {
    "registry": "https://git.kaynooo.fr/api/packages/kaynooo/npm/"
  },
  "scripts": {
    "build": "$npm_execpath build src/cli.ts --target bun --outdir dist",
    "stack": "$npm_execpath src/cli.ts"
  },
  "devDependencies": {
    "@kaynooo/cli-kit": "workspace:*"
  }
}
