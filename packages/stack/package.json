{
  "name": "@kaynooo/cli-stack",
  "type": "module",
  "version": "0.7.3",
  "description": "stack: a stable host port per service name, the same on every machine.",
  "author": "Kaynooo <contact@kaynooo.fr>",
  "license": "MIT",
  "homepage": "https://github.com/Kayno0o/cli/tree/main/packages/stack#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kayno0o/cli.git",
    "directory": "packages/stack"
  },
  "bugs": "https://github.com/Kayno0o/cli/issues",
  "keywords": ["docker", "compose", "port", "cli", "bun"],
  "bin": {
    "stack": "./dist/cli.js"
  },
  "files": ["dist"],
  "engines": {
