{
  "description": "guard answers each event; a missing guard fails without blocking the call.",
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash|Read|Edit|Write", "hooks": [{ "type": "command", "command": "guard hook pre-tool-use", "timeout": 60 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "guard hook user-prompt-submit", "timeout": 10 }] }
    ],
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "guard hook session-start", "timeout": 10 }] }
    ]
  }
}
